# Copy to .env for local development. Never commit .env.

# --- ARL API (read only) ---
ARL_API_ADDRESS=
ARL_API_PORT=

# --- MQTT broker ---
MQTT_BROKER_ADDRESS=
MQTT_BROKER_PORT=
MQTT_BROKER_USER=
MQTT_BROKER_PASSWORD=

# The undisclosed topic that publishes each service's topic structure.
MQTT_DISCOVERY_TOPIC=arl/services

# --- Database (Neon in production, docker compose locally) ---
DATABASE_URL=postgres://arl:arl@localhost:5432/arl
DATABASE_SSL=false

# --- HTTP ---
PORT=3000
# Comma separated; only needed when the web app is not proxied through Netlify.
WEB_ORIGINS=

# --- Ingest tuning ---
INGEST_FLUSH_MS=1000
INGEST_MAX_BATCH=500
INGEST_MAX_QUEUE=20000
